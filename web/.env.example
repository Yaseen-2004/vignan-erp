# Where the API is, for builds of this site.
#
# Leave empty when the portal and API are served from one origin — which is how
# `npm run dev` runs, through the Vite proxy.
#
# Set it to the API's address when they are deployed separately, without a
# trailing slash:
#
#   VITE_API_URL=https://vignan-erp-api.onrender.com
#
# The API must also allow this site in CORS_ORIGINS and send its session cookie
# cross-site (COOKIE_SAMESITE=none), or signing in will appear to work and then
# forget itself on the next page load.
VITE_API_URL=
