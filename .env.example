# ---------------------------------------------------------------------
# Vignan ERP — environment configuration
# Copy to server/.env and replace every secret before deploying.
# ---------------------------------------------------------------------
NODE_ENV=development
PORT=4000
APP_NAME="Vignan Educational Institutions ERP"

# ---------------------------------------------------------------------
# DATABASE — where the school's data actually lives
# ---------------------------------------------------------------------
# Set DATABASE_URL to your managed PostgreSQL and every record is stored
# in the cloud. Any provider works; the connection string is the only
# thing that changes.
#
#   Neon      postgresql://user:pass@ep-xxx.aws.neon.tech/vignan?sslmode=require
#   Supabase  postgresql://postgres:pass@db-xxx.supabase.co:5432/postgres
#   RDS       postgresql://user:pass@host.rds.amazonaws.com:5432/vignan
#
# Leave it empty and the server uses a local PostgreSQL (PGlite) under
# server/data/pg — same engine, nothing to install, for development.
DATABASE_URL=
DATABASE_POOL_MAX=10

# Only used by `npm run db:import` when moving off the old SQLite file.
DATABASE_FILE=./data/vignan_erp.db

# Secrets — REQUIRED in production, the server refuses to boot without them.
# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string
ACCESS_TOKEN_TTL=30m
REFRESH_TOKEN_TTL_DAYS=7

# ---------------------------------------------------------------------
# DEVICE NOTIFICATIONS (web push)
# ---------------------------------------------------------------------
# Generate a pair once, with:  npm run push:keys -w server
# They are this server's own identity to the browsers' push services — there is
# no third-party account. Leave them empty and push is off; the in-app bell is
# unaffected. Push needs HTTPS in production (localhost is exempt).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:office@vignan.edu

# ---------------------------------------------------------------------
# UPLOADED FILES — photographs, documents, course materials
# ---------------------------------------------------------------------
# Leave S3_BUCKET empty and files are written to UPLOAD_DIR below. That is
# right for development, and wrong for most hosts: a container usually gets a
# fresh filesystem on every deploy, so a redeploy takes every uploaded file
# with it. Records survive — they are in PostgreSQL — but the files they point
# at do not.
#
# Set these and files go to object storage instead, where they outlive the
# server. Any S3-compatible service works.
#
#   Cloudflare R2  S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
#                  S3_REGION=auto
#   Amazon S3      S3_ENDPOINT=https://s3.<region>.amazonaws.com
#                  S3_REGION=<region>
#
# For R2: create a bucket, then an API token with Object Read & Write, and use
# its Access Key ID and Secret Access Key below.
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Where files go when S3_BUCKET is empty.
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=10

# Security
BCRYPT_ROUNDS=10
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Hosting the portal separately from the API — the site on Cloudflare, the API
# on a Node host — makes every request between them cross-site, and a 'lax'
# cookie is not sent cross-site. Set this to 'none' for that arrangement (it
# requires https), and name the portal's address in CORS_ORIGINS above.
COOKIE_SAMESITE=lax

# Password given to demo accounts created by the seeder
SEED_PASSWORD=Vignan@123
